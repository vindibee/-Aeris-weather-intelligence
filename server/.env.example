PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Точные origin'ы. Сверх этого списка сервер сам пускает любой адрес локальной
# сети (192.168.*, 10.*, 172.16-31.*, 127.*) на портах 5173 и 4173 — чтобы
# открывать приложение с телефона без правки конфига при смене IP.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Ключ NASA Open API для раздела «Погода в космосе».
# Без него используется DEMO_KEY: работает без регистрации, но ограничен
# 30 запросами в час на IP. Свой ключ бесплатно — https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

# --- Вход через Google (необязательно) ---
# Создать в Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Вход через Telegram и связь с ботом (необязательно) ---
# Тот же токен, что в bot/.env. Домен сайта нужно привязать в @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Общий секрет с ботом для выдачи одноразовых ссылок входа
BOT_API_SECRET=

# Адрес фронтенда для OAuth-редиректов
WEB_ORIGIN=http://localhost:5173
