PORT=4000

# production включает защитный режим: secure-куки, обязательные JWT_SECRET и
# CORS_ORIGINS, отключённое послабление CORS для локальной сети, отсутствие
# демо-аккаунта. Локально не задавайте — работает дев-режим.
NODE_ENV=development

# Обязателен в production, минимум 32 символа. Сервер откажется стартовать с
# пустым или дефолтным значением: подписанный известной строкой токен
# равносилен отсутствию авторизации.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Точные origin'ы; в production переменная обязательна. В дев-режиме сверх
# этого списка сервер пускает любой адрес локальной сети (192.168.*, 10.*,
# 172.16-31.*, 127.*) на портах 5173 и 4173 — чтобы открывать приложение с
# телефона без правки конфига при смене IP. В production это послабление
# выключено.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Демо-аккаунт demo@aeris.app / demo1234 с паролем на странице входа. В
# production не создаётся; SEED_DEMO=1 — осознанно завести его и там.
SEED_DEMO=

# Ключ NASA Open API для раздела «Погода в космосе».
# Без него используется DEMO_KEY: работает без регистрации, но ограничен
# 30 запросами в час на IP. Свой ключ бесплатно — https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

# --- Вход через Google (необязательно) ---
# Создать в Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Вход через Telegram и связь с ботом (необязательно) ---
# Тот же токен, что в bot/.env. Домен сайта нужно привязать в @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Общий секрет с ботом для выдачи одноразовых ссылок входа.
# По сути мастер-ключ: маршрут /api/auth/telegram/issue выдаёт по нему код
# входа в ЛЮБОЙ аккаунт. В production обязателен и минимум 32 символа, плюс
# маршрут принимает запросы только с локального хоста.
BOT_API_SECRET=

# Разрешить вызов /telegram/issue с других машин — нужно, только если бот
# вынесен на отдельный хост. Иначе оставьте пустым.
BOT_ISSUE_ALLOW_REMOTE=

# Адрес фронтенда для OAuth-редиректов
WEB_ORIGIN=http://localhost:5173
