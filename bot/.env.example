# Токен бота от @BotFather. ОБЯЗАТЕЛЬНО свой — не переиспользуйте засвеченный.
TELEGRAM_BOT_TOKEN=

# Адрес API сайта, в который ходит бот
AERIS_API_BASE=http://localhost:4000/api
WEB_ORIGIN=http://localhost:5173

# Общий секрет между ботом и сервером для выдачи ссылок входа.
# Тот же самый должен стоять в server/.env
BOT_API_SECRET=

# Crypto Pay (@CryptoBot) — USDT/TON. Без токена кнопка криптооплаты скрыта.
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_API=https://pay.crypt.bot/api

# Цены премиума
PREMIUM_PRICE_STARS=150
PREMIUM_PRICE_USDT=2.5

BOT_DB_PATH=bot/data/bot.db
